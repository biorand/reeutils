<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <!-- Allow `dotnet restore`/build of this WPF app on non-Windows CI (Linux) where the
         solution is restored as a whole; it is only ever run on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RszViewer</AssemblyName>
    <RootNamespace>RszViewer</RootNamespace>
    <Authors>namsku</Authors>
    <Company>Namsku.BioHazard</Company>
    <Product>RszViewer</Product>
    <Description>Comparison tool for RE Engine files.</Description>
    <Copyright>Copyright © 2026 namsku</Copyright>
    <Version>1.0.0</Version>
    <ApplicationIcon>Resources\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\icon.png" />
    <Resource Include="Resources\icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- RSZ type dumps linked from reeutils (no duplication on disk, embedded in GUI assembly).
         Logical names end with rsz{game}.json.gz so GameCatalog can find them. -->
    <EmbeddedResource Include="..\reeutils\data\rszre2.json.gz" Link="data\rszre2.json.gz" />
    <EmbeddedResource Include="..\reeutils\data\rszre3.json.gz" Link="data\rszre3.json.gz" />
    <EmbeddedResource Include="..\reeutils\data\rszre4.json.gz" Link="data\rszre4.json.gz" />
    <EmbeddedResource Include="..\reeutils\data\rszre7.json.gz" Link="data\rszre7.json.gz" />
    <EmbeddedResource Include="..\reeutils\data\rszre8.json.gz" Link="data\rszre8.json.gz" />
    <EmbeddedResource Include="..\reeutils\data\rszre9.json.gz" Link="data\rszre9.json.gz" />
    <EmbeddedResource Include="..\reeutils\data\rszoniws.json.gz" Link="data\rszoniws.json.gz" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IntelOrca.Biohazard.REE\IntelOrca.Biohazard.REE.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ExcelDataReader" Version="3.8.0" />
    <PackageReference Include="ExcelDataReader.DataSet" Version="3.8.0" />
    <PackageReference Include="Ookii.Dialogs.Wpf" Version="5.0.1" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.2" />
    <PackageReference Include="BCnEncoder.Net" Version="2.2.1" />
    <PackageReference Include="BCnEncoder.Net.ImageSharp" Version="1.1.2" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

</Project>
